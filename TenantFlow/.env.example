PORT=3001
APP_ORIGIN=http://localhost:3001
NODE_ENV=development
# Optional for local use; required for persistent cloud deployment without a disk.
# DATABASE_URL=postgres://user:password@hostname:5432/database
# Only use your own Stripe sandbox / test-mode credentials for this project.
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# STRIPE_PRICE_PRO=price_replace_me
# STRIPE_PRICE_BUSINESS=price_replace_me
# Live payments are disabled unless deliberately enabled:
# STRIPE_ALLOW_LIVE=false
# Set only after confirming your trusted reverse-proxy chain (for Render, usually 1).
# TRUST_PROXY_HOPS=1
